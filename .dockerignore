# Keep the build context to what the Dockerfile copies.
**/bin/
**/obj/
**/node_modules/
web/dist/
web/src/api/generated/
web/src/routeTree.gen.ts
**/*.db
**/*.db-shm
**/*.db-wal
api/tests/
# Local development data: the Data Protection keys (a real key) and database backups.
api/src/Wwg.Api/keys/
api/src/Wwg.Api/backups/
# The end-to-end tests aren't part of the image (and their reports can be large).
e2e/
.git/
.github/
.husky/
.vscode/
docs/
scripts/
