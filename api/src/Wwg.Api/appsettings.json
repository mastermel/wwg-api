{
  "ConnectionStrings": {
    "Default": "Data Source=/data/wwg.db"
  },
  "Auth": {
    "DataProtectionKeysPath": "/data/keys"
  },
  "Backup": {
    "Path": "/data/backups"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "AllowedHosts": "*"
}
