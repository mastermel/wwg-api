<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Shared settings (target framework, nullable, analyzers) come from Directory.Build.props. -->

  <!--
    Every build writes the OpenAPI document to api/openapi.json: the committed contract the
    front-end SDK is generated from. CI fails if it's out of date.
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <UserSecretsId>1eecf179-bfa2-4987-815e-bd5b08ea614d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests seed and check data through the DbContext and entities directly. -->
    <InternalsVisibleTo Include="Wwg.Api.IntegrationTests" />
  </ItemGroup>
</Project>
